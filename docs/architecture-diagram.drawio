<mxfile host="app.diagrams.net" modified="2026-11-21T14:50:00.000Z" agent="Antigravity" version="24.0.0" type="device">
  <diagram id="umak-elec3-dcsad-g03-architecture" name="UMak ELEC3 Clinic Queue Architecture">
    <mxGraphModel dx="1420" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="850" background="#000B3C" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title" value="&lt;b style='font-size:18px; color:#F5CE3A;'&gt;University of Makati — ELEC3 Cloud Computing (Track B Final Exam)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:13px; color:#FFFFFF;'&gt;Section IV-DCSAD | Group 3 (dcsad-g03) — Case 4: School Clinic Visit Queue Architecture&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:11px; color:#94A3B8;'&gt;Region: AWS Asia Pacific (Singapore) ap-southeast-1 | Expected Traffic: 120 students/day (~25,000 req/mo)&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- CLIENT ACTORS LAYER -->
        <mxCell id="group-clients" value="Client / Actor Layer" style="swimlane;whiteSpace=wrap;html=1;startSize=24;fillColor=#041348;strokeColor=#14286F;fontColor=#F5CE3A;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="680" as="geometry" />
        </mxCell>

        <mxCell id="client-student" value="&lt;b style='color:#FFFFFF;'&gt;Senior High Student&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px; color:#94A3B8;'&gt;Mobile Smartphone Browser&lt;br/&gt;Access: S3 Static Website&lt;br/&gt;Action: Join Queue &amp;amp; Track Number&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#071A5A;strokeColor=#F5CE3A;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-clients">
          <mxGeometry x="15" y="50" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="client-nurse" value="&lt;b style='color:#FFFFFF;'&gt;School Nurse&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px; color:#94A3B8;'&gt;Clinic Admin Laptop&lt;br/&gt;Access: EC2 Web App (Port 80)&lt;br/&gt;Action: Call Next &amp;amp; Private Notes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#071A5A;strokeColor=#F5CE3A;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-clients">
          <mxGeometry x="15" y="270" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="client-counselor" value="&lt;b style='color:#FFFFFF;'&gt;Guidance Counselor&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px; color:#94A3B8;'&gt;Guidance Office Workstation&lt;br/&gt;Access: S3 Static Website&lt;br/&gt;Action: View Daily Visit Counts Only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#071A5A;strokeColor=#F5CE3A;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-clients">
          <mxGeometry x="15" y="510" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- VPC & EC2 LAYER -->
        <mxCell id="group-vpc" value="AWS VPC: IV-DCSAD Section Virtual Private Cloud (10.0.0.0/16)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#020B2C;strokeColor=#2563EB;strokeWidth=2;fontColor=#60A5FA;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="340" height="680" as="geometry" />
        </mxCell>

        <!-- Public Subnet -->
        <mxCell id="group-public-subnet" value="Group 3 Public Subnet (Routing: 0.0.0.0/0 -&gt; IGW)" style="swimlane;whiteSpace=wrap;html=1;startSize=22;fillColor=#071A5A;strokeColor=#10B981;fontColor=#34D399;fontStyle=1;rounded=1;" vertex="1" parent="group-vpc">
          <mxGeometry x="15" y="45" width="310" height="360" as="geometry" />
        </mxCell>

        <!-- EC2 Instance -->
        <mxCell id="ec2-instance" value="&lt;b style='font-size:13px; color:#F5CE3A;'&gt;Amazon EC2: t3.micro&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#FFFFFF; font-size:11px;'&gt;OS: Amazon Linux 2023 (gp3 8GB)&lt;br/&gt;Service: Flask + Gunicorn (Port 80)&lt;br/&gt;App: Nurse Station Admin Portal&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#38BDF8;'&gt;Security Group: dcsad-g03-nurse-sg&lt;/b&gt;&lt;br/&gt;Inbound: TCP 80 (HTTP)&lt;br/&gt;Outbound: TCP 443 (HTTPS to API GW)&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#F43F5E;'&gt;Security Boundary / Server-Side Proxy:&lt;/b&gt;&lt;br/&gt;Injects secret &lt;i&gt;x-nurse-key&lt;/i&gt; header.&lt;br/&gt;Student &amp;amp; Browser NEVER see secret key.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#00104A;strokeColor=#F5CE3A;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-public-subnet">
          <mxGeometry x="15" y="35" width="280" height="305" as="geometry" />
        </mxCell>

        <!-- Private Subnet -->
        <mxCell id="group-private-subnet" value="Group 3 Private Subnet (No Internet Facing Resources)" style="swimlane;whiteSpace=wrap;html=1;startSize=22;fillColor=#071330;strokeColor=#64748B;fontColor=#94A3B8;fontStyle=1;rounded=1;strokeDashArray=3 3;" vertex="1" parent="group-vpc">
          <mxGeometry x="15" y="430" width="310" height="230" as="geometry" />
        </mxCell>

        <mxCell id="private-subnet-note" value="&lt;b style='color:#94A3B8;'&gt;Isolated Class Lab Subnet&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px; color:#64748B;'&gt;No public IP / No direct internet ingress.&lt;br/&gt;Strictly adheres to exam constraint:&lt;br/&gt;&lt;i&gt;'Your private subnet stays private and holds nothing that faces the internet.'&lt;/i&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#000B26;strokeColor=#334155;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="group-private-subnet">
          <mxGeometry x="15" y="45" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- SERVERLESS CLOUD LAYER (AWS ap-southeast-1) -->
        <mxCell id="group-serverless" value="AWS Serverless Edge &amp; Backend Infrastructure (ap-southeast-1 Singapore)" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#03103E;strokeColor=#F59E0B;strokeWidth=2;fontColor=#FCD34D;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="110" width="580" height="680" as="geometry" />
        </mxCell>

        <!-- S3 Bucket -->
        <mxCell id="s3-bucket" value="&lt;b style='font-size:13px; color:#38BDF8;'&gt;Amazon S3 Static Website Hosting&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#F5CE3A;'&gt;Bucket: umak-elec3-dcsad-g03-clinic-web&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#E2E8F0; font-size:11px;'&gt;• index.html (Student Mobile Queue View)&lt;br/&gt;• counselor.html (Guidance Counselor Daily Counts)&lt;br/&gt;• styles.css, config.js&lt;br/&gt;&lt;b style='color:#F87171;'&gt;Strict Guard: S3 NEVER stores or handles medical notes&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#001A5E;strokeColor=#38BDF8;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-serverless">
          <mxGeometry x="25" y="45" width="530" height="90" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="api-gateway" value="&lt;b style='font-size:13px; color:#34D399;'&gt;Amazon API Gateway: HTTP API v2&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#F5CE3A;'&gt;umak-elec3-dcsad-g03-api&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#E2E8F0; font-size:11px;'&gt;CORS Enabled: * | Headers: Content-Type, x-nurse-key | Methods: GET, POST, OPTIONS&lt;br/&gt;&lt;b style='color:#FDE047;'&gt;Public Routes:&lt;/b&gt; POST /queue, GET /queue/status, GET /stats/daily&lt;br/&gt;&lt;b style='color:#F43F5E;'&gt;Nurse Protected Routes (x-nurse-key required):&lt;/b&gt; GET /nurse/queue, POST /nurse/call-next, POST /nurse/note&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#001A5E;strokeColor=#34D399;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-serverless">
          <mxGeometry x="25" y="165" width="530" height="110" as="geometry" />
        </mxCell>

        <!-- Lambda Function -->
        <mxCell id="lambda-function" value="&lt;b style='font-size:13px; color:#F59E0B;'&gt;AWS Lambda Function: umak-elec3-dcsad-g03-clinic-handler&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#FFFFFF; font-size:11px;'&gt;Runtime: Python 3.13 (Stdlib only + boto3, Zero pip dependencies)&lt;br/&gt;IAM Role: &lt;b style='color:#F5CE3A;'&gt;umak-elec3-dcsad-g03-lambda-role&lt;/b&gt; (Least-Privilege: Single-Table DynamoDB + Logs)&lt;br/&gt;&lt;br/&gt;&lt;b style='color:#38BDF8;'&gt;Core Logic &amp;amp; Privacy Controls:&lt;/b&gt;&lt;br/&gt;1. &lt;b&gt;Clinic Hours:&lt;/b&gt; Mon-Fri 07:00-17:00 PHT (UTC+8) enforcement | Bypassed if DEMO_MODE='true'&lt;br/&gt;2. &lt;b&gt;Atomic Concurrency:&lt;/b&gt; Atomic UpdateItem on COUNTER avoids race conditions under concurrent joins&lt;br/&gt;3. &lt;b&gt;Health Privacy Barrier:&lt;/b&gt; Student &amp;amp; Counselor APIs strictly project only queue_no, date, status &amp;amp; total_visits&lt;br/&gt;4. &lt;b&gt;Nurse Verification:&lt;/b&gt; Validates x-nurse-key against environment secret before opening clinical notes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#001A5E;strokeColor=#F59E0B;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-serverless">
          <mxGeometry x="25" y="305" width="530" height="155" as="geometry" />
        </mxCell>

        <!-- DynamoDB Table -->
        <mxCell id="dynamodb-table" value="&lt;b style='font-size:13px; color:#818CF8;'&gt;Amazon DynamoDB: Single-Table Architecture&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#F5CE3A;'&gt;Table: umak-elec3-dcsad-g03-clinic-queue (On-Demand / Pay-Per-Request)&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#E2E8F0; font-size:11px;'&gt;Primary Key: &lt;b style='color:#34D399;'&gt;PK (String)&lt;/b&gt; = DATE#YYYY-MM-DD  |  Sort Key: &lt;b style='color:#34D399;'&gt;SK (String)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b style='color:#FCD34D;'&gt;SK: 'COUNTER'&lt;/b&gt; -&gt; { last_number: 120, current_serving: 45, total_visits: 120, updated_at }&lt;br/&gt;• &lt;b style='color:#38BDF8;'&gt;SK: 'QUEUE#0001'&lt;/b&gt; -&gt; { queue_no: 1, display_no: 'Q-001', reason: 'Fever', status: 'WAITING', created_at }&lt;br/&gt;• &lt;b style='color:#F43F5E;'&gt;Confidential Record:&lt;/b&gt; { visit_note: 'Paracetamol 500mg, rest', attended_at } (Nurse View ONLY)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#001A5E;strokeColor=#818CF8;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="group-serverless">
          <mxGeometry x="25" y="490" width="530" height="155" as="geometry" />
        </mxCell>

        <!-- CONNECTORS / DATA FLOW ARROWS -->

        <!-- Student -> S3 -->
        <mxCell id="flow-student-s3" value="1. Load Web App (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#38BDF8;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="client-student" target="s3-bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Student -> API Gateway (POST /queue) -->
        <mxCell id="flow-student-apigw" value="2. POST /queue &amp; GET /queue/status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F5CE3A;strokeWidth=2;fontColor=#F5CE3A;fontStyle=1;exitX=1;exitY=0.7;entryX=0;entryY=0.2;" edge="1" parent="1" source="client-student" target="api-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nurse -> EC2 (Port 80) -->
        <mxCell id="flow-nurse-ec2" value="Port 80 (HTTP) PIN Sign-In &amp; Station" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F5CE3A;strokeWidth=2;fontColor=#F5CE3A;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client-nurse" target="ec2-instance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- EC2 -> API Gateway (HTTPS + x-nurse-key) -->
        <mxCell id="flow-ec2-apigw" value="Server-Side Proxy: Port 443 + Injected x-nurse-key Header" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2.5;fontColor=#34D399;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="ec2-instance" target="api-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Counselor -> S3 -->
        <mxCell id="flow-counselor-s3" value="Load counselor.html" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#38BDF8;strokeWidth=2;fontColor=#38BDF8;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.8;" edge="1" parent="1" source="client-counselor" target="s3-bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Counselor -> API Gateway (GET /stats/daily) -->
        <mxCell id="flow-counselor-apigw" value="GET /stats/daily (Daily totals only)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F5CE3A;strokeWidth=2;fontColor=#F5CE3A;fontStyle=1;exitX=1;exitY=0.7;entryX=0;entryY=0.9;" edge="1" parent="1" source="client-counselor" target="api-gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API Gateway -> Lambda -->
        <mxCell id="flow-apigw-lambda" value="Payload Format v2.0 (Direct Lambda Proxy Integration)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#34D399;strokeWidth=2.5;fontColor=#34D399;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="group-serverless" source="api-gateway" target="lambda-function">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda -> DynamoDB -->
        <mxCell id="flow-lambda-dynamodb" value="boto3: Atomic UpdateItem (ADD inc) | Filtered Query &amp; Scan (Projections)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F59E0B;strokeWidth=2.5;fontColor=#FCD34D;fontStyle=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="group-serverless" source="lambda-function" target="dynamodb-table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>