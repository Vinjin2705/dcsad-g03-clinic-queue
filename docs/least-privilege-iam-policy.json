{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBSingleTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:*:table/umak-elec3-dcsad-g03-clinic-queue"
    },
    {
      "Sid": "CloudWatchLogsAccess",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:*:log-group:/aws/lambda/umak-elec3-dcsad-g03-clinic-handler:*"
    },
    {
      "Sid": "CloudWatchLogGroupCreation",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "arn:aws:logs:ap-southeast-1:*:log-group:/aws/lambda/umak-elec3-dcsad-g03-clinic-handler"
    }
  ]
}
